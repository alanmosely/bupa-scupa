{
  "name": "bupa-scupa",
  "productName": "BUPA SCUPA",
  "version": "0.1.1",
  "description": "BUPA Simple Claims Utility & Personal Archive. An independent, local-first family claims companion.",
  "license": "GPL-3.0-or-later",
  "author": "BUPA SCUPA contributors",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron .",
    "agent": "node src/agent.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js && npm run lint && npm run typecheck && npm run format:check",
    "vendor": "node scripts/vendor.js",
    "build:pdf": "pwsh -NoProfile -File scripts/build-pdf.ps1",
    "icon": "node scripts/icon.js",
    "test:desktop": "node scripts/smoke.js",
    "test:portal": "node scripts/portal-smoke.js && node scripts/discovery-smoke.js",
    "build": "npm run check && npm run vendor && npm run build:pdf && npm run icon && npm test && electron-builder --win portable zip --x64 --publish never",
    "release:source": "node scripts/source-release.js",
    "format": "prettier --write \"src/**/*.{js,cjs,ts,html,css}\" \"scripts/**/*.js\" \"test/**/*.js\" \"docs/**/*.md\" \"*.{md,json,js}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{js,cjs,ts,html,css}\" \"scripts/**/*.js\" \"test/**/*.js\" \"docs/**/*.md\" \"*.{md,json,js}\" \".github/**/*.{yml,yaml}\"",
    "lint": "eslint src scripts test eslint.config.js",
    "typecheck": "tsc --project tsconfig.json",
    "release:check": "node scripts/release-check.js"
  },
  "dependencies": {
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "org.bupa-scupa.desktop",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "package.json",
      "LICENSE",
      "NOTICE",
      "PRIVACY.md",
      "AGENT_API.md"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/xpdf",
        "to": "xpdf",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "bupa-scupa-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "bupa-scupa-x64.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": true
    },
    "electronLanguages": [
      "en-GB",
      "en-US"
    ]
  }
}
